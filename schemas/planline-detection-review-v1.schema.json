{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/marlucool/floorplan-digitizer/blob/main/schemas/planline-detection-review-v1.schema.json",
  "title": "Planline Detection Review v1",
  "description": "Candidate detector output with optional human-reviewed dimension association hypotheses. This format is not a verified measurement or CAD geometry record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "source",
    "analysis",
    "counts",
    "detections",
    "limitations",
    "manual_dimension_text_review"
  ],
  "properties": {
    "schema_version": {
      "const": "planline-detection-review/v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "image_width_px",
        "image_height_px"
      ],
      "properties": {
        "filename": {
          "type": [
            "string",
            "null"
          ]
        },
        "image_width_px": {
          "type": "integer",
          "minimum": 1
        },
        "image_height_px": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "confidence_threshold",
        "status",
        "coordinate_system"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "confidence_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "status": {
          "const": "candidate_detection_only"
        },
        "coordinate_system": {
          "type": "string",
          "minLength": 1
        },
        "preprocessing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "brightness",
            "contrast",
            "method"
          ],
          "properties": {
            "brightness": {
              "type": "number",
              "minimum": -100,
              "maximum": 100
            },
            "contrast": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 2
            },
            "method": {
              "const": "linear_intensity_only"
            }
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall",
        "dimension_line",
        "dimension_value"
      ],
      "properties": {
        "wall": {
          "type": "integer",
          "minimum": 0
        },
        "dimension_line": {
          "type": "integer",
          "minimum": 0
        },
        "dimension_value": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "class_name",
          "confidence",
          "bbox"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^det-[0-9]{3,}$"
          },
          "class_name": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "bbox": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x1",
              "y1",
              "x2",
              "y2",
              "width",
              "height"
            ],
            "properties": {
              "x1": {
                "type": "number",
                "minimum": 0
              },
              "y1": {
                "type": "number",
                "minimum": 0
              },
              "x2": {
                "type": "number",
                "minimum": 0
              },
              "y2": {
                "type": "number",
                "minimum": 0
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "centre": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0
              },
              "y": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "manual_dimension_text_review": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "detection_id",
          "raw_text",
          "verified",
          "detector_confidence",
          "bbox",
          "crop_bbox",
          "text_style"
        ],
        "properties": {
          "detection_id": {
            "type": "string",
            "pattern": "^det-[0-9]{3,}$"
          },
          "raw_text": {
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          },
          "detector_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "bbox": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x1",
              "y1",
              "x2",
              "y2",
              "width",
              "height"
            ],
            "properties": {
              "x1": {
                "type": "number",
                "minimum": 0
              },
              "y1": {
                "type": "number",
                "minimum": 0
              },
              "x2": {
                "type": "number",
                "minimum": 0
              },
              "y2": {
                "type": "number",
                "minimum": 0
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "crop_bbox": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x1",
                  "y1",
                  "x2",
                  "y2",
                  "width",
                  "height"
                ],
                "properties": {
                  "x1": {
                    "type": "number",
                    "minimum": 0
                  },
                  "y1": {
                    "type": "number",
                    "minimum": 0
                  },
                  "x2": {
                    "type": "number",
                    "minimum": 0
                  },
                  "y2": {
                    "type": "number",
                    "minimum": 0
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "text_style": {
            "type": "string",
            "enum": [
              "unknown",
              "printed",
              "handwritten",
              "unclear"
            ]
          },
          "association": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "dimension_line_id",
              "wall_ids",
              "wall_span_px",
              "confirmed",
              "candidate_lines"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "candidate",
                  "ambiguous",
                  "unmatched"
                ]
              },
              "dimension_line_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "wall_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "wall_span_px": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "confirmed": {
                "type": "boolean"
              },
              "candidate_lines": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "dimension_line_id",
                    "orientation",
                    "score",
                    "assignment_score",
                    "wall_span_status",
                    "wall_spans"
                  ],
                  "properties": {
                    "dimension_line_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "orientation": {
                      "type": "string",
                      "enum": [
                        "horizontal",
                        "vertical"
                      ]
                    },
                    "score": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "wall_spans": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "wall_ids",
                          "orientation",
                          "method",
                          "span_px",
                          "score",
                          "assignment_score",
                          "globally_assigned",
                          "globally_assigned_to"
                        ],
                        "properties": {
                          "wall_ids": {
                            "type": "array",
                            "minItems": 2,
                            "maxItems": 2,
                            "items": {
                              "type": "string"
                            }
                          },
                          "orientation": {
                            "type": "string",
                            "enum": [
                              "horizontal",
                              "vertical"
                            ]
                          },
                          "method": {
                            "type": "string",
                            "enum": [
                              "between_vertical_walls",
                              "between_horizontal_walls"
                            ]
                          },
                          "span_px": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "score": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "gap_center_px": {
                            "type": "number"
                          },
                          "text_center_offset_px": {
                            "type": "number"
                          },
                          "line_center_offset_px": {
                            "type": "number"
                          },
                          "endpoint_residual_px": {
                            "type": "number",
                            "minimum": 0
                          },
                          "perpendicular_offset_px": {
                            "type": "number",
                            "minimum": 0
                          },
                          "intervening_wall_count": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "assignment_score": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "globally_assigned": {
                            "type": "boolean"
                          },
                          "globally_assigned_to": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        }
                      }
                    },
                    "assignment_score": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "wall_span_status": {
                      "type": "string",
                      "enum": [
                        "candidate",
                        "ambiguous",
                        "unmatched"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "calibration": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "points_px",
            "pixel_distance",
            "known_distance",
            "input_unit",
            "known_distance_mm",
            "pixels_per_mm",
            "source_filename",
            "source_page_index",
            "status"
          ],
          "properties": {
            "method": {
              "const": "user_two_point_reference"
            },
            "points_px": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            },
            "pixel_distance": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "known_distance": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "input_unit": {
              "type": "string",
              "enum": [
                "mm",
                "cm",
                "m",
                "in",
                "ft"
              ]
            },
            "known_distance_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "pixels_per_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "source_filename": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_page_index": {
              "type": "integer",
              "minimum": 0
            },
            "status": {
              "const": "user_supplied_reference_not_geometry_validation"
            }
          }
        }
      ]
    },
    "manual_geometry": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "start_px",
          "end_px",
          "source_page_index",
          "created_by_user"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "const": "wall_segment"
          },
          "start_px": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0
              },
              "y": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "end_px": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0
              },
              "y": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "source_page_index": {
            "type": "integer",
            "minimum": 0
          },
          "created_by_user": {
            "const": true
          }
        }
      }
    }
  }
}
