{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/marlucool/floorplan-digitizer/blob/main/schemas/planline-project-v1.schema.json",
  "title": "Planline Project v1",
  "description": "Portable local Planline workspace containing its original source file, analysis result and human review state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "created_at",
    "source",
    "analysis_result",
    "review"
  ],
  "properties": {
    "format": {
      "const": "planline-project"
    },
    "format_version": {
      "const": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "mime_type",
        "last_modified",
        "size_bytes",
        "data_base64"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "mime_type": {
          "type": "string"
        },
        "last_modified": {
          "type": "integer",
          "minimum": 0
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 26214400
        },
        "data_base64": {
          "type": "string",
          "minLength": 4,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      }
    },
    "analysis_result": {
      "type": "object",
      "required": [
        "image",
        "detections",
        "preview_data_url"
      ],
      "properties": {
        "image": {
          "type": "object",
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "detections": {
          "type": "array"
        },
        "preview_data_url": {
          "type": "string",
          "pattern": "^data:image/"
        }
      },
      "additionalProperties": true
    },
    "review": {
      "type": "object",
      "required": [
        "schema_version",
        "generated_at",
        "source",
        "analysis",
        "counts",
        "detections",
        "manual_dimension_text_review",
        "limitations"
      ],
      "properties": {
        "schema_version": {
          "const": "planline-detection-review/v1"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "object"
        },
        "analysis": {
          "type": "object"
        },
        "counts": {
          "type": "object"
        },
        "detections": {
          "type": "array"
        },
        "manual_dimension_text_review": {
          "type": "array"
        },
        "calibration": {
          "type": [
            "object",
            "null"
          ]
        },
        "limitations": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "geometry": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "start_px",
          "end_px",
          "source_page_index"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "const": "wall_segment"
          },
          "start_px": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0
              },
              "y": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "end_px": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0
              },
              "y": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "source_page_index": {
            "type": "integer",
            "minimum": 0
          },
          "created_by_user": {
            "const": true
          },
          "created_by_reconstruction": {
            "const": true
          },
          "source_detection_id": {
            "type": "string",
            "pattern": "^det-[0-9]{3,}$"
          },
          "detector_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "wall_orientation": {
            "type": "string",
            "enum": [
              "horizontal",
              "vertical"
            ]
          },
          "wall_face_index": {
            "type": "integer",
            "enum": [
              1,
              2
            ]
          }
        },
        "oneOf": [
          {
            "required": [
              "created_by_user"
            ]
          },
          {
            "required": [
              "created_by_reconstruction",
              "source_detection_id",
              "detector_confidence",
              "wall_orientation",
              "wall_face_index"
            ]
          }
        ]
      }
    },
    "geometry_next_id": {
      "type": "integer",
      "minimum": 1
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "vertices_px",
          "source_page_index",
          "created_by_user"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "const": "room_polygon"
          },
          "vertices_px": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "x",
                "y"
              ],
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0
                },
                "y": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          "source_page_index": {
            "type": "integer",
            "minimum": 0
          },
          "created_by_user": {
            "const": true
          }
        }
      }
    },
    "room_next_id": {
      "type": "integer",
      "minimum": 1
    },
    "reconstruction": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "geometry_kind",
            "segments",
            "scale",
            "measurements",
            "skipped_dimensions",
            "skipped_walls",
            "wall_regions_used",
            "warnings",
            "junction_candidates",
            "junction_tolerance_px"
          ],
          "properties": {
            "status": {
              "const": "draft"
            },
            "geometry_kind": {
              "const": "detected_wall_face_edges"
            },
            "segments": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "type",
                  "start_px",
                  "end_px",
                  "source_page_index",
                  "created_by_reconstruction",
                  "source_detection_id",
                  "detector_confidence",
                  "wall_orientation",
                  "wall_face_index"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^reconstructed-wall-[0-9]{4,}$"
                  },
                  "type": {
                    "const": "wall_segment"
                  },
                  "start_px": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "x",
                      "y"
                    ],
                    "properties": {
                      "x": {
                        "type": "number",
                        "minimum": 0
                      },
                      "y": {
                        "type": "number",
                        "minimum": 0
                      }
                    }
                  },
                  "end_px": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "x",
                      "y"
                    ],
                    "properties": {
                      "x": {
                        "type": "number",
                        "minimum": 0
                      },
                      "y": {
                        "type": "number",
                        "minimum": 0
                      }
                    }
                  },
                  "source_page_index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "created_by_reconstruction": {
                    "const": true
                  },
                  "source_detection_id": {
                    "type": "string",
                    "pattern": "^det-[0-9]{3,}$"
                  },
                  "detector_confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "wall_orientation": {
                    "type": "string",
                    "enum": [
                      "horizontal",
                      "vertical"
                    ]
                  },
                  "wall_face_index": {
                    "type": "integer",
                    "enum": [
                      1,
                      2
                    ]
                  }
                }
              }
            },
            "scale": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pixels_per_mm_x",
                "pixels_per_mm_y",
                "source"
              ],
              "properties": {
                "pixels_per_mm_x": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "pixels_per_mm_y": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "source": {
                  "const": "confirmed_dimension_to_wall_associations"
                }
              }
            },
            "measurements": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "detection_id",
                  "raw_text",
                  "value_mm",
                  "unit",
                  "dimension_line_id",
                  "wall_ids",
                  "orientation",
                  "axis",
                  "span_px",
                  "pixels_per_mm",
                  "association_score"
                ],
                "properties": {
                  "detection_id": {
                    "type": "string",
                    "pattern": "^det-[0-9]{3,}$"
                  },
                  "raw_text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value_mm": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1
                  },
                  "dimension_line_id": {
                    "type": "string",
                    "pattern": "^det-[0-9]{3,}$"
                  },
                  "wall_ids": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "string",
                      "pattern": "^det-[0-9]{3,}$"
                    }
                  },
                  "orientation": {
                    "type": "string",
                    "enum": [
                      "horizontal",
                      "vertical"
                    ]
                  },
                  "axis": {
                    "type": "string",
                    "enum": [
                      "x",
                      "y"
                    ]
                  },
                  "span_px": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "pixels_per_mm": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "association_score": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  }
                }
              }
            },
            "skipped_dimensions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "skipped_walls": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "detection_id",
                  "reason"
                ],
                "properties": {
                  "detection_id": {
                    "type": "string",
                    "pattern": "^det-[0-9]{3,}$"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "wall_regions_used": {
              "type": "integer",
              "minimum": 1
            },
            "warnings": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "junction_tolerance_px": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "junction_candidates": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "point_px",
                  "source_detection_ids",
                  "segment_ids",
                  "endpoint_count",
                  "status"
                ],
                "properties": {
                  "point_px": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "x",
                      "y"
                    ],
                    "properties": {
                      "x": {
                        "type": "number",
                        "minimum": 0
                      },
                      "y": {
                        "type": "number",
                        "minimum": 0
                      }
                    }
                  },
                  "source_detection_ids": {
                    "type": "array",
                    "minItems": 2,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^det-[0-9]{3,}$"
                    }
                  },
                  "segment_ids": {
                    "type": "array",
                    "minItems": 2,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^reconstructed-wall-[0-9]{4,}$"
                    }
                  },
                  "endpoint_count": {
                    "type": "integer",
                    "minimum": 2
                  },
                  "status": {
                    "const": "candidate_requires_review"
                  },
                  "endpoints": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "segment_id",
                        "endpoint",
                        "original_point_px"
                      ],
                      "properties": {
                        "segment_id": {
                          "type": "string",
                          "pattern": "^reconstructed-wall-[0-9]{4,}$"
                        },
                        "endpoint": {
                          "type": "string",
                          "enum": [
                            "start_px",
                            "end_px"
                          ]
                        },
                        "original_point_px": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "x",
                            "y"
                          ],
                          "properties": {
                            "x": {
                              "type": "number",
                              "minimum": 0
                            },
                            "y": {
                              "type": "number",
                              "minimum": 0
                            }
                          }
                        }
                      }
                    }
                  },
                  "review_status": {
                    "type": "string",
                    "enum": [
                      "pending",
                      "joined"
                    ]
                  }
                }
              }
            },
            "opening_candidates": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "wall_ids",
                  "axis",
                  "start_px",
                  "end_px",
                  "gap_bbox",
                  "width_mm",
                  "status"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^opening-candidate-[0-9]{3,}$"
                  },
                  "wall_ids": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^det-[0-9]{3,}$"
                    }
                  },
                  "axis": {
                    "type": "string",
                    "enum": [
                      "x",
                      "y"
                    ]
                  },
                  "start_px": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "x",
                      "y"
                    ],
                    "properties": {
                      "x": {
                        "type": "number",
                        "minimum": 0
                      },
                      "y": {
                        "type": "number",
                        "minimum": 0
                      }
                    }
                  },
                  "end_px": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "x",
                      "y"
                    ],
                    "properties": {
                      "x": {
                        "type": "number",
                        "minimum": 0
                      },
                      "y": {
                        "type": "number",
                        "minimum": 0
                      }
                    }
                  },
                  "gap_bbox": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "x1",
                      "y1",
                      "x2",
                      "y2"
                    ],
                    "properties": {
                      "x1": {
                        "type": "number",
                        "minimum": 0
                      },
                      "y1": {
                        "type": "number",
                        "minimum": 0
                      },
                      "x2": {
                        "type": "number",
                        "minimum": 0
                      },
                      "y2": {
                        "type": "number",
                        "minimum": 0
                      }
                    }
                  },
                  "width_mm": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "status": {
                    "const": "candidate_requires_review"
                  },
                  "review_status": {
                    "type": "string",
                    "enum": [
                      "pending",
                      "added"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
